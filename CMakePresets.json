{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "win",
      "hidden": true,
      "inherits": "vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-debug",
      "displayName": "windows debug",
      "inherits": "win",
      "binaryDir": "${sourceDir}/build/win-debug",
      "$comment": "-Wno-c2y-extensions: silences Catch2's __COUNTER__ use in TEST_CASE, flagged by -Wpedantic",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -Wpedantic -Wno-c2y-extensions -Wnrvo -g3 -O0"
      }
    },
    {
      "name": "win-release",
      "displayName": "windows release",
      "inherits": "win",
      "binaryDir": "${sourceDir}/build/win-release",
      "$comment": "-Wno-c2y-extensions: silences Catch2's __COUNTER__ use in TEST_CASE, flagged by -Wpedantic",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -Wpedantic -Wno-c2y-extensions -Wnrvo -O2"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "linux debug",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -Wpedantic -g3 -O0"
      }
    },
    {
      "name": "linux-release",
      "displayName": "linux release",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -Wpedantic -O2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-debug"
    },
    {
      "name": "win-release",
      "configurePreset": "win-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "editor-windows-debug",
      "configurePreset": "win-debug",
      "targets": ["godot_editor_dev"]
    },
    {
      "name": "editor-linux-debug",
      "configurePreset": "linux-release",
      "targets": ["godot_editor_dev"]
    },
    {
      "name": "editor-windows-release",
      "configurePreset": "win-debug",
      "targets": ["godot_editor_release"]
    },
    {
      "name": "editor-linux-release",
      "configurePreset": "linux-release",
      "targets": ["godot_editor_release"]
    },
    {
      "name": "game-windows-debug",
      "configurePreset": "win-debug",
      "targets": ["godot_game_debug"]
    },
    {
      "name": "game-windows-release",
      "configurePreset": "win-release",
      "targets": ["godot_game_release"]
    },
    {
      "name": "game-linux-debug",
      "configurePreset": "linux-debug",
      "targets": ["godot_game_debug"]
    },
    {
      "name": "game-linux-release",
      "configurePreset": "linux-release",
      "targets": ["godot_game_release"]
    }
  ],
  "testPresets": [
    {
      "name": "win-debug",
      "configurePreset": "win-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "win-debug",
      "steps": [
        { "type": "configure", "name": "win-debug" },
        { "type": "build", "name": "win-debug" },
        { "type": "test", "name": "win-debug" }
      ]
    },
    {
      "name": "win-release",
      "steps": [
        { "type": "configure", "name": "win-release" },
        { "type": "build", "name": "win-release" },
        { "type": "test", "name": "win-release" }
      ]
    },
    {
      "name": "linux-debug",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build", "name": "linux-debug" },
        { "type": "test", "name": "linux-debug" }
      ]
    },
    {
      "name": "linux-release",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build", "name": "linux-release" },
        { "type": "test", "name": "linux-release" }
      ]
    }
  ]
}
