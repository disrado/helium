{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "win",
      "hidden": true,
      "inherits": "vcpkg",
      "cacheVariables": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-debug",
      "displayName": "windows debug",
      "inherits": "win",
      "binaryDir": "${sourceDir}/build/win-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -Wnrvo -g3 -O0"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "linux release",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_FLAGS": "-std=c++2c -Wall -Wextra -Wshadow -O2",
        "CMAKE_EXE_LINKER_FLAGS": "-lstdc++exp"
      }
    }
  ]
}
